# ── Required ──────────────────────────────────────────────────────────────────
API_ID=your_api_id
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token
ALLOWED_GROUP_IDS=-100xxxxxxxxxx
ADMIN_IDS=user_id_1,user_id_2

# ── Resource tuning (all default to "auto") ───────────────────────────────────
# MAX_CONCURRENT_ENCODINGS=1   # override: 1 for 1 GB, 2 for 4 GB+
# FFMPEG_THREADS=2             # override: 2 for 1 GB, 0 = FFmpeg auto
# LOW_MEMORY_MODE=auto         # auto | true | false
# MAX_RAM_MB=auto              # override detected RAM (useful on containers)
# TEMP_DIR=/tmp/encode_bot     # where to store job files (use /tmp on Heroku/Render)
# PROGRESS_UPDATE_INTERVAL=4   # seconds between FFmpeg progress callback
# MIN_FREE_DISK_MB=512         # minimum free disk before accepting a job

# ── Pyrogram tuning ───────────────────────────────────────────────────────────
# PYROGRAM_WORKERS=8           # Pyrogram handler thread count (default 8)
# PYROGRAM_MAX_TX=4            # max concurrent Telegram transfers (default 4)

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=encode_bot
